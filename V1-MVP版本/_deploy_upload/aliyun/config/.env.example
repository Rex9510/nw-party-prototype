# ============================================================================
# 党员学时统计系统 V1-MVP · 生产 .env 模板
# ----------------------------------------------------------------------------
# 用法：cp .env.example .env.production  →  填好真实值  →  deploy.sh 会自动
#       部署到 /var/www/nwparty/.env（权限 600）
# 严禁 commit 到 git（已加进 .gitignore）
#
# 当前部署：试点用 SQLite（100 人内 / 低并发），未来要扩到 PG 只需：
#   1. 注释掉 DATABASE_URL 这行
#   2. 填下面 PostgreSQL/Redis 段
#   3. 准备 PG 库、跑 alembic upgrade head
# ============================================================================

# ---- 应用 ----
DEBUG=false
APP_VERSION=1.0.0
APP_NAME="党员学时统计系统 API"

# ---- CORS（填实际前端域名，不要带通配符）----
# 例：CORS_ORIGINS=["https://v1.nwparty.example.cn","https://nwdj.example.cn"]
# 试点用 IP+端口访问时，临时配成 ["*"] 也行（DEBUG=true 时），
# 但 DEBUG=false + CORS=* 会被 status.sh 警告
CORS_ORIGINS=["*"]

# ---- 数据库（试点：SQLite；未来扩 PG 时注释此行并填下面 PG 段）----
DATABASE_URL=sqlite+aiosqlite:////var/www/nwparty/data/nwparty.db

# ---- PostgreSQL（未来扩 PG 时启用，先注释不填）----
#POSTGRES_HOST=
#POSTGRES_PORT=5432
#POSTGRES_USER=nwparty
#POSTGRES_PASSWORD=
#POSTGRES_DB=nwparty

# ---- Redis（试点用 SQLite 时不需要，留空）----
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- JWT（必改！生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"）----
JWT_SECRET=__FILL_STRONG_RANDOM_48_BYTES__
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ---- 对象存储（试点不接 OSS，留空）----
STORAGE_PROVIDER=local
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_SECURE=false

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# ---- 文件上传 ----
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=["image/jpeg","image/png","image/webp","application/pdf"]

# ---- 部署时给 deploy.sh 用的变量（不会进应用配置）----
# 你的实际前端域名（nginx server_name）
# 试点用 IP 访问时填 _
PUBLIC_SERVER_NAME=_
# 前端用的 API base（留空则走同源 /api/v1，强烈推荐留空）
PUBLIC_API_BASE=
